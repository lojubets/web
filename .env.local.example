# 100% local: copy to .env.local and run `npm run dev` (or `npm run dev:local`).
# Everything here is optional; with no .env.local at all you get the defaults below.

# A SQLite file in the project folder. No token needed.
DATABASE_URL=file:local.db

# Shows a "dev login" form so you can sign in without any OAuth setup (never available in production)
DEV_LOGIN=on

# Optional: only to try real sign-in providers locally. Register http://localhost:5173/api/auth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Optional: real emails (invitations, verification, reminders). Without it they're printed in the API console.
# RESEND_API_KEY=
# RESEND_FROM=Lojubets <invites@your-verified-domain.example>
