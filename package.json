{
  "name": "lojubets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bets between friends. The prize is always one beer.",
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "concurrently -n api,web -c yellow,cyan \"npm:api:local\" \"npm:web\"",
    "dev:cloud": "concurrently -n api,web -c yellow,cyan \"npm:api:cloud\" \"npm:web\"",
    "api:local": "node --env-file-if-exists=.env.local --import tsx --watch server/dev.ts",
    "api:cloud": "node --env-file=.env.cloud --import tsx --watch server/dev.ts",
    "web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
