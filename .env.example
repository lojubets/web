# --- Core ---
# Dev defaults to a local SQLite file. In production use a free Turso database.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Long random string, e.g. `openssl rand -hex 32` (required in production)
SESSION_SECRET=
# Public URL of the app (OAuth redirect URIs are APP_URL + /api/auth/<provider>/callback)
APP_URL=http://localhost:5173

# --- Sign-in providers (each is enabled only when its variables are set) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
APPLE_CLIENT_ID=        # the Services ID
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=      # contents of the .p8 file, newlines as \n

# --- Optional: invitation emails (otherwise the UI offers a shareable link) ---
RESEND_API_KEY=
RESEND_FROM=Lojubets <invites@your-verified-domain.example>

# Dev only: show a "dev login" form (no OAuth needed). Ignored in production.
DEV_LOGIN=on
